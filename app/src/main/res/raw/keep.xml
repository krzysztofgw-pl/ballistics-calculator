<?xml version="1.0" encoding="utf-8"?>
<!--
  CloudSync looks up the Google OAuth web client id (generated by the google-services
  plugin from app/google-services.json) by name through getIdentifier, so the resource
  shrinker sees no reference to it. AGP 9's optimized resource shrinking removed it,
  and Google sign-in then failed with "no Google client ID".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
